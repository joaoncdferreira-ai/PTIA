{
  "firestore": {
    "database": "(default)",
    "location": "eur3",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "anonymous": false,
      "emailPassword": false
    }
  },
  "functions": {
    "source": "firebase_functions",
    "codebase": "ptia-cloud",
    "runtime": "python313",
    "predeploy": [
      "python scripts/prepare_firebase_functions.py"
    ]
  }
}
